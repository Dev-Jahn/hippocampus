{
  "description": "hippo (Codex CLI): status capsule at session start and after a compaction; detached scribe on Stop. SubagentStart and PreCompact live in hooks.json (Claude Code) until measured on codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
