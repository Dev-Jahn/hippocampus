#!/usr/bin/env bash
# hippo shim — resolves the repo root from its own location and runs cli/hippo_cli.py.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
root="$(cd -P "$(dirname "$src")/.." && pwd)"
cli="$root/cli/hippo_cli.py"

if command -v uv >/dev/null 2>&1; then
  exec uv run --quiet --script "$cli" "$@"
elif command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' >/dev/null 2>&1; then
  exec python3 "$cli" "$@"
else
  echo "hippo: needs uv (or a python3 with pyyaml). Install: https://docs.astral.sh/uv/" >&2
  exit 1
fi
